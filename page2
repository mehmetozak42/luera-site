<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Luera Kozmetik</title>
  <meta name="description" content="Luera Kozmetik hizmetinizde. Online mağazamız çok yakında.">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html, body {
      width: 100%;
      height: 100%;
      background: #f8f4ee;
    }

    body {
      display: flex;
      justify-content: center;
      align-items: center;
      overflow: hidden;
    }

    .hero {
      width: 100%;
      height: 100dvh;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .hero img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      object-position: center;
      display: block;
    }
  </style>
</head>
<body>
  <main class="hero">
    <img src="luera-yeni.png" alt="Luera Kozmetik Hizmetinizde">
  </main>
</body>
</html>
